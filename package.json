{
  "name": "bookmarks-sync",
  "version": "1.2.4",
  "description": "Self-hosted multi-user bookmark sync server (SQLite + Node.js)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --experimental-test-isolation=process --test-concurrency=1 'tests/**/*.test.js'",
    "test:unit": "node --test --experimental-test-isolation=process tests/crypto.test.js tests/timeFormat.test.js tests/rateLimit.test.js tests/securityConfig.test.js tests/bookmarkHelpers.test.js",
    "ext:sync": "node bookmarks-extension/scripts/sync-firefox.mjs",
    "ext:firefox": "node bookmarks-extension/scripts/sync-firefox.mjs",
    "ext:check": "node bookmarks-extension/scripts/check-extension-sync.mjs",
    "ext:pack": "node bookmarks-extension/scripts/pack.mjs all",
    "ext:pack-chrome": "node bookmarks-extension/scripts/pack.mjs chrome",
    "ext:pack-firefox": "node bookmarks-extension/scripts/pack.mjs firefox",
    "ext:prepare-store": "node bookmarks-extension/scripts/prepare-store.mjs",
    "ext:sign-firefox": "node bookmarks-extension/scripts/sign-firefox.mjs",
    "ext:lint-firefox": "npx --yes web-ext@10 lint --source-dir bookmarks-extension/firefox"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "bookmarks",
    "sync",
    "sqlite",
    "self-hosted"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
