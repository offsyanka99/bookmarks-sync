{
  "name": "bookmarks-sync",
  "version": "1.2.3",
  "description": "Self-hosted multi-user bookmark sync server (SQLite + Node.js)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "ext:sync": "node bookmarks-extension/scripts/sync-firefox.mjs",
    "ext:firefox": "node bookmarks-extension/scripts/sync-firefox.mjs",
    "ext:check": "node bookmarks-extension/scripts/check-extension-sync.mjs",
    "ext:pack": "node bookmarks-extension/scripts/pack.mjs all",
    "ext:pack-chrome": "node bookmarks-extension/scripts/pack.mjs chrome",
    "ext:pack-firefox": "node bookmarks-extension/scripts/pack.mjs firefox",
    "ext:prepare-store": "node bookmarks-extension/scripts/prepare-store.mjs",
    "ext:sign-firefox": "node bookmarks-extension/scripts/sign-firefox.mjs",
    "ext:lint-firefox": "npx --yes web-ext@8 lint --source-dir bookmarks-extension/firefox"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "bookmarks",
    "sync",
    "sqlite",
    "self-hosted"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "morgan": "^1.10.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
